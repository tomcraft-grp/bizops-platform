{
  "name": "bizops-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Business Operations & Commerce Management Platform - interactive prototype",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:seed": "tsx scripts/seedtest.ts && tsx scripts/scenarios.ts",
    "perf": "tsx scripts/perf.ts",
    "qa:evidence": "tsx scripts/qa-evidence.ts",
    "docs:accounting": "tsx scripts/gen-accounting-docs.ts"
  },
  "dependencies": {
    "immer": "10.1.1",
    "lucide-react": "0.469.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "^2.1.8"
  }
}
